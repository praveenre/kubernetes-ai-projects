# ==============================================================================
# Provider selection: meshapi, openrouter, or openai
# ==============================================================================
LLM_PROVIDER=meshapi

# --- Mesh API Configuration (https://meshapi.ai) ---
MESH_API_KEY=your-mesh-api-key
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_MODEL=openai/gpt-4o-mini

# --- Model Selection & Pricing (e.g. gpt-4o-mini) ---
DIAGNOSTICS_MODEL_ID=openai/gpt-4o-mini
REMEDIATION_MODEL_ID=openai/gpt-4o-mini

DIAGNOSTICS_MODEL_PRICE_INPUT_PER_1K=0.00015
DIAGNOSTICS_MODEL_PRICE_OUTPUT_PER_1K=0.00060
REMEDIATION_MODEL_PRICE_INPUT_PER_1K=0.00015
REMEDIATION_MODEL_PRICE_OUTPUT_PER_1K=0.00060

# --- Alternative: OpenRouter Configuration ---
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# DIAGNOSTICS_MODEL_ID=openai/gpt-4o-mini
# REMEDIATION_MODEL_ID=openai/gpt-4o-mini

# --- Postgres Database (for conversation history & state checkpointing) ---
# DATABASE_URL=postgresql://ai_agent:changeme@127.0.0.1:5432/ai_agent








